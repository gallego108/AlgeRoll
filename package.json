{
  "name": "algeroll-definitivo",
  "version": "1.3.4",
  "private": true,
  "type": "module",
  "description": "AlgeRoll - versión definitiva local con caras impresas de cartas, dados cúbicos 3D y aviso de turno",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node server.mjs --port 4173",
    "test": "node --test tests/*.test.mjs",
    "dev": "node server.mjs --port 4173",
    "icon": "node scripts/make-icon.mjs",
    "electron": "electron .",
    "dist": "npm run icon && electron-builder --win portable",
    "dist:installer": "npm run icon && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.algeroll.juego",
    "productName": "AlgeRoll",
    "asar": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "server.mjs",
      "index.html",
      "styles.css",
      "src/**/*",
      "assets/**/*",
      "!assets/references/**",
      "!docs/**",
      "!tests/**",
      "!**/*.log",
      "!**/*.pid"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "AlgeRoll-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "AlgeRoll-${version}-setup.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
